{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/quiniela",
      "destination": "/index.html"
    },
    {
      "source": "/quiniela/:code",
      "destination": "/index.html"
    }
  ]
}
